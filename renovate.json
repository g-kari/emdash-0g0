{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "ignoreScripts": true,
  "ignorePlugins": true,
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "14 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Require manual review until real CI and automerge eligibility are verified.",
      "matchPackageNames": [
        "*"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "automerge": false
  },
  "lockFileMaintenance": {
    "enabled": false,
    "automerge": false
  }
}
